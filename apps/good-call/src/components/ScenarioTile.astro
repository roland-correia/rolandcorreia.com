---
// One scenario in a set's list. The status line is filled in by
// src/scripts/set-progress.ts once the visitor has answered it.
import { pathOf, type Scenario } from '../lib/scenarios';
import { href } from '../lib/paths';

interface Props {
  scenario: Scenario;
}

const { scenario } = Astro.props;
---

<li>
  <a class="tile" href={href(pathOf(scenario))} data-scenario-link data-id={scenario.id}>
    <b>{scenario.data.title}</b>
    <small>{scenario.data.topic}</small>
    <small class="status" data-status hidden></small>
  </a>
</li>
