---
// Where to get help. Shown with the sets that can bring things up for the reader.
// Links only: each service keeps its own contact details current.
// A set with no entry here shows its group's entry, if there is one, or nothing.
import { sets, type SetId, type GroupId } from '../lib/site';

interface Props {
  set: SetId;
}

interface Service {
  name: string;
  detail: string;
  url: string;
}

const support: Partial<Record<SetId, { summary: string; lead: string; services: Service[] }>> = {
  consent: {
    summary: 'If this brings something up for you',
    lead: 'You can stop at any time. These UK services are free and confidential. In an emergency, call 999.',
    services: [
      {
        name: 'Rape Crisis England & Wales',
        detail: 'Free 24/7 support line and online chat for anyone aged 16 or over.',
        url: 'https://247sexualabusesupport.org.uk/',
      },
      {
        name: 'SurvivorsUK',
        detail: 'For men, boys and non-binary people who have experienced sexual violence.',
        url: 'https://www.survivorsuk.org/',
      },
      {
        name: 'Galop',
        detail: 'For LGBT+ people who have experienced abuse or violence.',
        url: 'https://galop.org.uk/',
      },
      {
        name: 'Revenge Porn Helpline',
        detail: 'For adults whose intimate images have been shared, or threatened to be.',
        url: 'https://revengepornhelpline.org.uk/',
      },
      {
        name: 'Childline',
        detail: 'For anyone under 19, about anything, including things they have seen online.',
        url: 'https://www.childline.org.uk/',
      },
      {
        name: 'NSPCC',
        detail: 'Advice for parents and carers on talking to children about porn and online safety.',
        url: 'https://www.nspcc.org.uk/',
      },
      {
        name: 'Internet Watch Foundation',
        detail: 'Report sexual images or videos of anyone under 18. You can do it anonymously.',
        url: 'https://www.iwf.org.uk/report/',
      },
      {
        name: 'Brook',
        detail: 'Honest information about sex and relationships for young people.',
        url: 'https://www.brook.org.uk/',
      },
      {
        name: 'Relate',
        detail: 'Relationship and sex therapy, including when porn is causing problems.',
        url: 'https://www.relate.org.uk/',
      },
      {
        name: 'Stop It Now',
        detail: 'Confidential, anonymous help if you are worried about what you are looking at online.',
        url: 'https://www.stopitnow.org.uk/',
      },
      {
        name: 'Samaritans',
        detail: 'Someone to talk to, day or night, about anything.',
        url: 'https://www.samaritans.org/',
      },
    ],
  },
  racism: {
    summary: 'If this has happened to you, or you have seen it',
    lead: 'These UK services are free to use. If you or someone else is in immediate danger, call 999.',
    services: [
      {
        name: 'Stop Hate UK',
        detail: 'Support for anyone affected by hate crime, and a way to report it without going to the police.',
        url: 'https://www.stophateuk.org/',
      },
      {
        name: 'True Vision',
        detail: 'The police website for reporting hate crime online.',
        url: 'https://www.report-it.org.uk/',
      },
      {
        name: 'Victim Support',
        detail: 'Free, confidential support after a crime, whether or not you report it.',
        url: 'https://www.victimsupport.org.uk/',
      },
      {
        name: 'Citizens Advice',
        detail: 'What counts as discrimination, and what you can do about it.',
        url: 'https://www.citizensadvice.org.uk/law-and-courts/discrimination/',
      },
      {
        name: 'Acas',
        detail: 'Free advice on discrimination and your rights at work.',
        url: 'https://www.acas.org.uk/',
      },
      {
        name: 'Kick It Out',
        detail: 'Report racism and other discrimination in football, at a ground or online.',
        url: 'https://www.kickitout.org/',
      },
      {
        name: 'Samaritans',
        detail: 'Someone to talk to, day or night, about anything.',
        url: 'https://www.samaritans.org/',
      },
    ],
  },

};

// Every parenting module shares one list.
const groupSupport: Partial<Record<GroupId, { summary: string; lead: string; services: Service[] }>> = {
  parenting: {
    summary: 'Where to get help and advice',
    lead: 'These UK services are free to use. For health worries call NHS 111. In an emergency, call 999.',
    services: [
      {
        name: 'NHS 111',
        detail: 'Urgent health advice for you or your child, day or night, online or by phone.',
        url: 'https://111.nhs.uk/',
      },
      {
        name: 'The Lullaby Trust',
        detail: 'Safer sleep advice for babies, with a baby safety helpline.',
        url: 'https://www.lullabytrust.org.uk/',
      },
      {
        name: 'ICON',
        detail: 'Help for coping with a crying baby.',
        url: 'https://iconcope.org/',
      },
      {
        name: 'PANDAS',
        detail: 'Support for parents with depression or anxiety before or after a birth, including partners.',
        url: 'https://pandasfoundation.org.uk/',
      },
      {
        name: 'Family Lives',
        detail: 'A free, confidential helpline for any parenting worry, at any age.',
        url: 'https://www.familylives.org.uk/',
      },
      {
        name: 'YoungMinds Parents Helpline',
        detail: "Advice if you are worried about your child's mental health.",
        url: 'https://www.youngminds.org.uk/parent/parents-helpline-and-webchat/',
      },
      {
        name: 'CEOP',
        detail: 'Report an adult who is contacting a child online in a worrying way.',
        url: 'https://www.ceop.police.uk/Safety-Centre/',
      },
      {
        name: 'Adoption UK',
        detail: 'Support and community for adoptive families.',
        url: 'https://www.adoptionuk.org/',
      },
      {
        name: 'Kinship',
        detail: 'Support for grandparents, relatives and friends raising a child.',
        url: 'https://kinship.org.uk/',
      },
      {
        name: 'Gingerbread',
        detail: 'Advice and support for single parents.',
        url: 'https://www.gingerbread.org.uk/',
      },
    ],
  },
};

const entry = support[Astro.props.set] ?? groupSupport[sets[Astro.props.set].group];
---

{
  entry && (
    <details class="support">
      <summary>{entry.summary}</summary>
      <p>{entry.lead}</p>
      <ul>
        {entry.services.map((service) => (
          <li>
            <a href={service.url} target="_blank" rel="noopener">
              {service.name}
            </a>
            <span>{service.detail}</span>
          </li>
        ))}
      </ul>
    </details>
  )
}
