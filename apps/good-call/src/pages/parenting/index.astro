---
import Base from '../../layouts/Base.astro';
import SetTiles from '../../components/SetTiles.astro';
import { href } from '../../lib/paths';

// The parenting course: one module for each age, then two for any age.
---

<Base
  title="The parenting course"
  description="A parenting course in everyday scenarios, by your child's age. For birth, adoptive, foster and kinship families, and first-time parents most of all."
  path="/parenting/"
  back={{ href: href('/'), label: 'Back' }}
>
  <p class="kicker">Parenting</p>
  <h1>The parenting<br /><span>course</span></h1>
  <p class="lead">
    Nobody is handed a manual. This course follows a child from the first weeks to adulthood, through the moments
    parents most often find hard, and builds the judgement to handle them well.
  </p>
  <p class="lead">
    It is for every kind of family: birth, adoptive, foster and kinship, single parents and co-parents, and
    first-time parents most of all. Begin with your child's stage, or with the two modules for any age.
  </p>

  <section class="card" aria-labelledby="themes-title">
    <h2 id="themes-title">Four themes at every stage</h2>
    <ul class="ticks">
      <li><span><b>Safety and safeguarding.</b> Protecting children, and recognising risk early.</span></li>
      <li><span><b>Emotional wellbeing.</b> Understanding feelings, and support through hard moments.</span></li>
      <li><span><b>Development and milestones.</b> Growth, firsts and the gradual steps to independence.</span></li>
      <li><span><b>Behaviour, values and character.</b> Kindness, honesty and responsibility.</span></li>
    </ul>
    <p class="meta">
      The safety advice follows NHS, Lullaby Trust, Child Accident Prevention Trust and government guidance.
    </p>
  </section>
  <p class="notice">
    General guidance, not medical advice. If you are worried about your child's health, call NHS 111. In an
    emergency, call 999.
  </p>

  <SetTiles group="parenting" />
</Base>
