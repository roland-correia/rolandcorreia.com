---
import Base from '../../layouts/Base.astro';
import SetTiles from '../../components/SetTiles.astro';
import { href } from '../../lib/paths';

// The work sets: interview questions for any role, then each role.
---

<Base
  title="Workplace readiness"
  description="Practice interview questions and situational judgement questions for the job you are applying for. Untimed, with the reason for every answer."
  path="/work/"
  back={{ href: href('/'), label: 'Back' }}
>
  <p class="kicker">Work and careers</p>
  <h1>Workplace<br /><span>readiness</span></h1>
  <p class="lead">
    Many employers use situational judgement tests: a situation at work, a few possible actions, and you pick the best
    one. Interviews ask the same kind of thing out loud. Both are usually timed, and neither tells you why an answer
    was wrong.
  </p>
  <p class="lead">
    Here you can practise with no clock and see the reasoning behind every answer. Start with interview skills,
    then choose the field you are applying for.
  </p>

  <SetTiles group="work" />
</Base>
