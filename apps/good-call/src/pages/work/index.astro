---
import Base from '../../layouts/Base.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { getLiveSets } from '../../lib/scenarios';
import { sets, type SetId } from '../../lib/site';
import { href } from '../../lib/paths';

// The work sets: interview questions for any role, then each role. A set with
// scenarios links to its page; the rest show as "coming later".
const liveSets = await getLiveSets();
const scenariosOf = new Map(liveSets.map(({ id, scenarios }) => [id, scenarios]));
const roles = (Object.keys(sets) as SetId[]).filter((id) => sets[id].group === 'work');
---

<Base
  title="At work"
  description="Practice interview questions and situational judgement questions for the job you are applying for. Untimed, with the reason for every answer."
  path="/work/"
  back={{ href: href('/'), label: 'Back' }}
>
  <p class="kicker">At work</p>
  <h1>Interviews and roles</h1>
  <p class="lead">
    Many employers use situational judgement tests: a situation at work, a few possible actions, and you pick the best
    one. Interviews ask the same kind of thing out loud. Both are usually timed, and neither tells you why an answer
    was wrong.
  </p>
  <p class="lead">
    Here you can practise with no clock, and see the reasoning behind every answer. Start with the interview
    questions, or choose your role.
  </p>

  <ul class="tiles">
    {
      roles.map((id) => {
        const scenarios = scenariosOf.get(id);
        const n = scenarios?.length;
        return (
          <li>
            {scenarios ? (
              <a class="tile" href={href(`/practice/${id}/`)}>
                <b>{sets[id].name}</b>
                <small>{sets[id].blurb}</small>
                <small>
                  {n} {n === 1 ? 'scenario' : 'scenarios'}
                </small>
                <ProgressBar name={sets[id].name} scenarios={scenarios} />
              </a>
            ) : (
              <div class="tile off">
                <b>{sets[id].name}</b>
                <small>Coming later</small>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</Base>
