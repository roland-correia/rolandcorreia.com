---
// A module's page: what it covers, and its topics. Each topic opens as a deck of
// cards on its own page. No questions are shown here.
import Base from '../../../layouts/Base.astro';
import Support from '../../../components/Support.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import { getLiveSets, sectionsOf, topicPathOf, type Scenario } from '../../../lib/scenarios';
import { sets, groups, type SetId } from '../../../lib/site';
import { href } from '../../../lib/paths';

export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.map(({ id, scenarios }) => ({ params: { set: id }, props: { id, scenarios } }));
}

const { id, scenarios } = Astro.props as { id: SetId; scenarios: Scenario[] };
const set = sets[id];
const isWork = set.group === 'work';
const group = groups[set.group];
// Only live sets get a page, and every live set has these.
const { intro, note, rules } = set as Extract<typeof set, { live: true }>;
const topics = sectionsOf(id, scenarios);
const count = (n: number) => `${n} ${n === 1 ? 'question' : 'questions'}`;
// Start / Carry on opens the topic holding the first unanswered question.
const sequence = JSON.stringify(
  topics.flatMap((topic) => topic.scenarios.map((s) => ({ id: s.id, href: href(topicPathOf(id, topic.id)) }))),
);
---

<Base
  title={set.name}
  description={intro}
  path={`/practice/${id}/`}
  back={{ href: href(group.path), label: 'Back' }}
>
  <div class="stack" data-set={id}>
    <div class="group">
      <p class="kicker">{group.name}</p>
      <h1>{set.name}</h1>
      <p class="lead">{intro}</p>
      <p class="notice">{note}</p>
      <p class="meta">{count(scenarios.length)} across {topics.length} topics</p>

      <a class="btn block" href={href(topicPathOf(id, topics[0].id))} data-start data-sequence={sequence}>Start</a>
      <ProgressBar name={set.name} scenarios={scenarios} />
    </div>

    <nav class="group" aria-labelledby="topics-title">
      <h2 id="topics-title">Topics</h2>
      <ul class="tiles">
        {
          topics.map((topic) => (
            <li>
              <a class="tile topic-tile" href={href(topicPathOf(id, topic.id))}>
                <b>{topic.name}</b>
                <small>{topic.blurb}</small>
                <small>{count(topic.scenarios.length)}</small>
                <ProgressBar name={topic.name} scenarios={topic.scenarios} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button type="button" class="textbtn" data-reset hidden>Clear my answers and start this module again</button>
  </div>

  <section class="card" aria-labelledby="rules-title">
    <h2 id="rules-title">
      {isWork ? 'What employers look for' : 'Key principles'}
    </h2>
    {isWork && <p class="meta">The unwritten rules behind these questions, said out loud:</p>}
    <ul class="ticks">
      {rules.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <Support set={id} />

  <script>
    import '../../../scripts/set-progress.ts';
  </script>
</Base>
