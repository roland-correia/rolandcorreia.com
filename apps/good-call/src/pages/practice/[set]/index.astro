---
import Base from '../../../layouts/Base.astro';
import Support from '../../../components/Support.astro';
import ScenarioTile from '../../../components/ScenarioTile.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import { getLiveSets, pathOf, sectionsOf, type Scenario } from '../../../lib/scenarios';
import { sets, type SetId } from '../../../lib/site';
import { href } from '../../../lib/paths';

export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.map(({ id, scenarios }) => ({ params: { set: id }, props: { id, scenarios } }));
}

const { id, scenarios } = Astro.props as { id: SetId; scenarios: Scenario[] };
const set = sets[id];
const isWork = set.group === 'work';
// Only live sets get a page, and every live set has these.
const { intro, note, rules } = set as Extract<typeof set, { live: true }>;
// A set with categories is shown in sections, with links to jump between them.
const sections = sectionsOf(id, scenarios);
const count = (n: number) => `${n} ${n === 1 ? 'scenario' : 'scenarios'}`;
---

<Base
  title={set.name}
  description={intro}
  path={`/practice/${id}/`}
  back={{ href: href(isWork ? '/work/' : '/'), label: 'Back' }}
>
  <div class="stack" data-set={id}>
    <div class="group">
      <p class="kicker">{isWork ? 'At work' : 'Everyday life'}</p>
      <h1>{set.name}</h1>
      <p class="lead">{intro}</p>
      <p class="notice">{note}</p>

      <a class="btn block" href={href(pathOf(scenarios[0]))} data-start>Start</a>
      <ProgressBar name={set.name} scenarios={scenarios} />
    </div>

    {
      sections.length > 0 ? (
        <>
          <nav class="group" aria-labelledby="jump-title">
            <h2 id="jump-title">Choose a topic</h2>
            <ul class="jump">
              {sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.name}</a>
                </li>
              ))}
            </ul>
          </nav>

          {sections.map((section) => (
            <section class="group" id={section.id} aria-labelledby={`${section.id}-title`} data-section>
              <h2 id={`${section.id}-title`}>{section.name}</h2>
              <p class="meta">
                {section.blurb}. <span data-section-count>{count(section.scenarios.length)}</span>
              </p>
              <ol class="tiles">
                {section.scenarios.map((scenario) => (
                  <ScenarioTile scenario={scenario} />
                ))}
              </ol>
            </section>
          ))}
        </>
      ) : (
        <ol class="tiles">
          {scenarios.map((scenario) => (
            <ScenarioTile scenario={scenario} />
          ))}
        </ol>
      )
    }

    <button type="button" class="textbtn" data-reset hidden>Clear my answers and start this set again</button>
  </div>

  <section class="card" aria-labelledby="rules-title">
    <h2 id="rules-title">{isWork ? 'The unwritten rules' : 'The ideas behind these'}</h2>
    {isWork && <p class="meta">What these questions are usually looking for, said out loud:</p>}
    <ul class="ticks">
      {rules.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <Support set={id} />

  <script>
    import '../../../scripts/set-progress.ts';
  </script>
</Base>
