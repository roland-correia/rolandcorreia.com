---
import Base from '../../../layouts/Base.astro';
import Support from '../../../components/Support.astro';
import ScenarioTile from '../../../components/ScenarioTile.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import { getLiveSets, pathOf, sectionsOf, chapterPathOf, sequenceOf, type Scenario } from '../../../lib/scenarios';
import { sets, groups, type SetId } from '../../../lib/site';
import { href } from '../../../lib/paths';

export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.map(({ id, scenarios }) => ({ params: { set: id }, props: { id, scenarios } }));
}

const { id, scenarios } = Astro.props as { id: SetId; scenarios: Scenario[] };
const set = sets[id];
const isWork = set.group === 'work';
const group = groups[set.group];
// Only live sets get a page, and every live set has these.
const { intro, note, rules } = set as Extract<typeof set, { live: true }>;
// A set with categories is split into chapters, each with its own page.
const sections = sectionsOf(id, scenarios);
const count = (n: number) => `${n} ${n === 1 ? 'scenario' : 'scenarios'}`;
---

<Base
  title={set.name}
  description={intro}
  path={`/practice/${id}/`}
  back={{ href: href(group.path), label: 'Back' }}
>
  <div class="stack" data-set={id}>
    <div class="group">
      <p class="kicker">{group.name}</p>
      <h1>{set.name}</h1>
      <p class="lead">{intro}</p>
      <p class="notice">{note}</p>

      <a class="btn block" href={href(pathOf(scenarios[0]))} data-start data-sequence={sequenceOf(scenarios, href)}>
        Start
      </a>
      <ProgressBar name={set.name} scenarios={scenarios} />
    </div>

    {
      sections.length > 0 ? (
        <>
          <section class="group" aria-labelledby="chapters-title">
            <h2 id="chapters-title">Chapters</h2>
            <ol class="tiles">
              {sections.map((section, index) => (
                <li>
                  <a class="tile" href={href(chapterPathOf(id, section.id))}>
                    <small class="chapter-no">Chapter {index + 1}</small>
                    <b>{section.name}</b>
                    <small>{section.blurb}</small>
                    <small>{count(section.scenarios.length)}</small>
                    <ProgressBar name={section.name} scenarios={section.scenarios} />
                  </a>
                </li>
              ))}
            </ol>
          </section>
        </>
      ) : (
        <ol class="tiles">
          {scenarios.map((scenario) => (
            <ScenarioTile scenario={scenario} />
          ))}
        </ol>
      )
    }

    <button type="button" class="textbtn" data-reset hidden>Clear my answers and start this set again</button>
  </div>

  <section class="card" aria-labelledby="rules-title">
    <h2 id="rules-title">
      {isWork ? 'What employers look for' : 'Key principles'}
    </h2>
    {isWork && <p class="meta">The unwritten rules behind these questions, said out loud:</p>}
    <ul class="ticks">
      {rules.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <Support set={id} />

  <script>
    import '../../../scripts/set-progress.ts';
  </script>
</Base>
