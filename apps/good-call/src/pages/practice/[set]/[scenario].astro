---
import Base from '../../../layouts/Base.astro';
import Support from '../../../components/Support.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import { getLiveSets, pathOf, slugOf, sectionsOf, chapterPathOf, type Scenario, type Section } from '../../../lib/scenarios';
import { sets, calls } from '../../../lib/site';
import { href } from '../../../lib/paths';

// In a set with chapters, a scenario is numbered within its chapter, Back returns to
// the chapter, and the last scenario in a chapter leads on to the next chapter.
export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.flatMap(({ id, scenarios }) => {
    const sections = sectionsOf(id, scenarios);
    return scenarios.map((entry) => {
      const index = sections.findIndex((section) => section.id === entry.data.category);
      const chapter = sections[index];
      const siblings = chapter ? chapter.scenarios : scenarios;
      const position = siblings.indexOf(entry);
      return {
        params: { set: id, scenario: slugOf(entry) },
        props: { entry, siblings, position, chapter, nextChapter: sections[index + 1] },
      };
    });
  });
}

const { entry, siblings, position, chapter, nextChapter } = Astro.props as {
  entry: Scenario;
  /** The scenarios in this chapter, or in the whole set if it has no chapters. */
  siblings: Scenario[];
  position: number;
  chapter?: Section;
  nextChapter?: Section;
};
const scenario = entry.data;
const set = sets[scenario.set];
const setPath = href(`/practice/${scenario.set}/`);
const chapterPath = chapter ? href(chapterPathOf(scenario.set, chapter.id)) : undefined;
const backPath = chapterPath ?? setPath;
const next = siblings[position + 1];
// The label above the title names the chapter, or the set if it has no chapters.
const place = chapter ? chapter.name : set.name;
const paragraphs = scenario.situation.trim().split(/\n\s*\n/);
---

<Base
  title={scenario.title}
  description={`${set.name} scenario: ${scenario.topic}. Choose what you would do and see why.`}
  path={pathOf(entry)}
  back={{ href: backPath, label: 'Back' }}
>
  {scenario.draft && <p class="notice">Draft. This scenario is not published yet.</p>}

  <article data-scenario data-id={entry.id}>
    <header class="group">
      <p class="kicker">{place}. Scenario {position + 1} of {siblings.length}. {scenario.topic}</p>
      <h1>{scenario.title}</h1>
      <ProgressBar name={chapter ? chapter.name : set.name} scenarios={siblings} />
    </header>

    <div class="prose situation">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <form data-quiz>
      <fieldset>
        <legend>{scenario.question}</legend>
        {
          scenario.options.map((option, index) => (
            <div class="opt" data-option data-call={option.call}>
              <label>
                <input type="radio" name="answer" value={index} />
                <span>
                  {option.text}
                  <em class="yours" data-yours hidden>Your answer</em>
                </span>
              </label>
              <div class="why" data-why data-call={option.call} tabindex="-1">
                <b>
                  <span aria-hidden="true">{calls[option.call].mark}</span> {calls[option.call].label}
                </b>
                <p>{option.why}</p>
              </div>
            </div>
          ))
        }
      </fieldset>

      <p class="hint" data-hint role="alert" hidden>Choose an answer first. There is no time limit.</p>
      <button class="btn block" data-check hidden>Lock in my answer</button>
      <p class="fine" data-once hidden>You get one go. Once you lock in an answer, you cannot change it.</p>
      <p class="fine" data-locked hidden>Your answer is locked in and cannot be changed.</p>
      <button type="button" class="btn ghost block" data-show-all hidden>Show the reasons for the other answers</button>
    </form>

    <div data-after>
      <section class="principle">
        <h2>The principle</h2>
        <p>{scenario.principle}</p>
      </section>

      <nav class="stepper" aria-label="Scenarios">
        {
          next ? (
            <a class="btn block" href={href(pathOf(next))}>
              Next: {next.data.title}
            </a>
          ) : nextChapter ? (
            <a class="btn block" href={href(chapterPathOf(scenario.set, nextChapter.id))}>
              Next chapter: {nextChapter.name}
            </a>
          ) : (
            <a class="btn block" href={setPath}>
              Finish: back to {set.name}
            </a>
          )
        }
      </nav>
    </div>
  </article>

  <Support set={scenario.set} />

  <script>
    import '../../../scripts/scenario.ts';
  </script>
</Base>
