---
// A single scenario on a page of its own, for links that point straight to it.
// The usual way through is its module's deck of cards.
import Base from '../../../layouts/Base.astro';
import Support from '../../../components/Support.astro';
import QuizCard from '../../../components/QuizCard.astro';
import { getLiveSets, pathOf, slugOf, sectionsOf, type Scenario, type Section } from '../../../lib/scenarios';
import { sets } from '../../../lib/site';
import { href } from '../../../lib/paths';

export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.flatMap(({ id, scenarios }) => {
    const sections = sectionsOf(id, scenarios);
    // The order of cards in the module's deck: topic after topic.
    const deck = sections.length > 0 ? sections.flatMap((section) => section.scenarios) : scenarios;
    return scenarios.map((entry) => ({
      params: { set: id, scenario: slugOf(entry) },
      props: {
        entry,
        card: deck.indexOf(entry) + 1,
        chapter: sections.find((section) => section.id === entry.data.category),
      },
    }));
  });
}

const { entry, card, chapter } = Astro.props as {
  entry: Scenario;
  /** This scenario's place in its module's deck, counting from 1. */
  card: number;
  chapter?: Section;
};
const scenario = entry.data;
const set = sets[scenario.set];
const setPath = href(`/practice/${scenario.set}/`);
// Back, and the button after answering, return to this card in its module's deck.
const quizPath = `${setPath}#card=${card}`;
const label = chapter ? `${chapter.name}. ${scenario.topic}` : scenario.topic;
---

<Base
  title={scenario.title}
  description={`${set.name} scenario: ${scenario.topic}. Choose what you would do and see why.`}
  path={pathOf(entry)}
  back={{ href: quizPath, label: 'Back' }}
>
  {scenario.draft && <p class="notice">Draft. This scenario is not published yet.</p>}

  <QuizCard entry={entry} label={label} as="page">
    <nav class="stepper" aria-label="Module" slot="after">
      <a class="btn block" href={quizPath}>Continue {set.name}</a>
    </nav>
  </QuizCard>

  <Support set={scenario.set} />

  <script>
    import '../../../scripts/scenario.ts';
  </script>
</Base>
