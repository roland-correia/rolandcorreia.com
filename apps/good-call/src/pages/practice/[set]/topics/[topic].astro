---
// Topics used to have pages of their own. Each module is now one deck, so these
// addresses send people to the first card of that topic in its module's deck.
import { getLiveSets, sectionsOf, type Scenario } from '../../../../lib/scenarios';
import { href } from '../../../../lib/paths';

export async function getStaticPaths() {
  const liveSets = await getLiveSets();
  return liveSets.flatMap(({ id, scenarios }) => {
    const topics = sectionsOf(id, scenarios);
    const order: Scenario[] = topics.flatMap((topic) => topic.scenarios);
    return topics.map((topic) => ({
      params: { set: id, topic: topic.id },
      props: { target: `${href(`/practice/${id}/`)}#card=${order.indexOf(topic.scenarios[0]) + 1}` },
    }));
  });
}

// A permanent redirect, so the browser moves on straight away.
return Astro.redirect((Astro.props as { target: string }).target, 301);
---
