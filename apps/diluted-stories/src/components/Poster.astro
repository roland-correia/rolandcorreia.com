---
// The video poster. It is also the design used for share images, so one look
// covers the site, TikTok, Instagram and link previews.
// With an `href` it links out to the video; there is no embedded player, so no
// third-party scripts load on the page.
// With `image` instead (no video yet), it shows a real photo behind the
// caption with a scrim for legibility, rather than a flat colour block.
interface Props {
  caption: string;
  chip?: string;
  href?: string;
  square?: boolean;
  image?: string;
  imageAlt?: string;
}

const { caption, chip, href, square = false, image, imageAlt = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
const label = href ? `Watch the video${chip ? ` (${chip})` : ''}: ${caption}` : undefined;
---

<Tag
  class:list={['poster', { sq: square, photo: !!image }]}
  href={href}
  target={href ? '_blank' : undefined}
  rel={href ? 'noopener' : undefined}
  aria-label={label}
>
  {image && <img class="poster-bg" src={image} alt={imageAlt} loading="lazy" />}
  {chip && <span class="chip">{chip}</span>}
  <p class="cap">{caption}</p>
</Tag>
