---
// The tutor and student app: a full-width page with one interactive island.
// It runs only in the browser (client:only), because everything it shows comes
// from the signed-in person's data.
import Head from '../components/Head.astro';
import App from '../app/App';
import '../styles/app.css';

interface Props {
  title: string;
  path: string;
  page: 'sign-in' | 'dashboard' | 'chats' | 'credits';
}

const { title, path, page } = Astro.props;
---

<!doctype html>
<html lang="en-GB" data-size="md" data-space="normal" data-bg="auto" data-pinyin="show">
  <head>
    <Head title={title} path={path} description="The 5 Minute Mandarin app for tutors and students." />
    <meta name="robots" content="noindex" />
  </head>
  <body class="app-body">
    <App client:only="preact" page={page} />
    <noscript><p class="shell">The tutor and student app needs JavaScript.</p></noscript>
  </body>
</html>
