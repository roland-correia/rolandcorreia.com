---
// The signed-in screens: the usual page with one interactive island in it.
// It runs only in the browser (client:only), because everything it shows comes
// from the signed-in person's data.
import Base from './Base.astro';
import App, { type Page } from '../app/App';
import { getLessons, pathOf } from '../lib/lessons';
import { href } from '../lib/paths';

interface Props {
  title: string;
  path: string;
  page: Page;
}

const { title, path, page } = Astro.props;
// The dashboard shows practice progress, so it needs the list of practice lessons.
const practice = (await getLessons()).map((l) => ({ id: l.id, title: l.data.title, path: href(pathOf(l)) }));
const nav = page === 'sign-in' ? 'sign-in' : page;
---

<Base title={title} path={path} nav={nav} noindex={page !== 'sign-in'} description="The 5 Minute Mandarin app for tutors and students.">
  <App client:only="preact" page={page} practice={practice} />
  <noscript><p>The tutor and student app needs JavaScript.</p></noscript>
</Base>
