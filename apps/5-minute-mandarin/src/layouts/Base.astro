---
import Head from '../components/Head.astro';
import Wordmark from '../components/Wordmark.astro';
import SettingsDialog from '../components/SettingsDialog.astro';
import { href } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** The page's own path, e.g. '/about/', used for the canonical and share URLs. */
  path: string;
  /** Leave out on the home page, which shows the wordmark instead of a Back button. */
  back?: { href: string; label: string };
}

const { title, description, path, back } = Astro.props;
---

<!doctype html>
<html lang="en-GB" data-size="md" data-space="normal" data-bg="auto" data-pinyin="show">
  <head>
    <Head title={title} description={description} path={path} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="bar">
        {back ? <a class="iconbtn" href={back.href}>{back.label}</a> : <Wordmark />}
        <button type="button" class="iconbtn" data-open-settings aria-haspopup="dialog" aria-label="Reading settings">Aa</button>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="foot">
        <p>
          <b>5 Minute Mandarin</b> brings Mandarin tutors and students together: lessons on Zoom, group chats for
          each class, and free five-minute practice lessons for complete beginners.{' '}
          <a href={href('/about/')}>About 5 Minute Mandarin</a> · <a href={href('/blog/')}>Blog</a>
        </p>
        <p>
          The tutor and student app is a prototype with sample data. The practice lessons are first versions and have
          not yet been reviewed by a Mandarin teacher.
        </p>
        <p>
          © 2026 5 Minute Mandarin, a subsidiary of{' '}
          <a href="https://dilutedstories.com/">Diluted Stories</a>.
        </p>
      </footer>
    </div>
    <SettingsDialog />
    <script>
      import '../scripts/settings.ts';
      import '../scripts/speak.ts';
    </script>
  </body>
</html>
