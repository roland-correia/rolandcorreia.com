---
// Every page: the sidebar on the left (src/app/Sidebar.tsx) and the page on the right.
// The sidebar runs in the browser because it shows who is signed in. Its column is
// part of this page, so the layout does not move while it loads.
import Head from '../components/Head.astro';
import SettingsDialog from '../components/SettingsDialog.astro';
import Sidebar, { type NavId } from '../app/Sidebar';
import '../styles/app.css';

interface Props {
  title: string;
  description?: string;
  /** The page's own path, e.g. '/about/', used for the canonical and share URLs. */
  path: string;
  /** Which sidebar item to highlight. */
  nav: NavId;
  /** Signed-in screens are not for search engines. */
  noindex?: boolean;
}

const { title, description, path, nav, noindex } = Astro.props;
---

<!doctype html>
<html lang="en-GB" data-size="md" data-space="normal" data-bg="auto" data-pinyin="show">
  <head>
    <Head title={title} description={description} path={path} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app">
      <aside class="side">
        <Sidebar client:only="preact" current={nav} />
      </aside>
      <main id="main" class="app-main">
        <slot />
        <footer class="foot">
          <p>
            © 2026 5 Minute Mandarin, all rights reserved. Prototype design by <a href="https://dilutedstories.com/">Diluted Stories</a>.
          </p>
        </footer>
      </main>
    </div>
    <SettingsDialog />
    <script>
      import '../scripts/settings.ts';
      import '../scripts/speak.ts';
    </script>
  </body>
</html>
