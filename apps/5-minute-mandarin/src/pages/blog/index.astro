---
import Base from '../../layouts/Base.astro';
import { getPosts, postDate as date } from '../../lib/posts';
import { href } from '../../lib/paths';

const posts = await getPosts();
---

<Base title="Blog" description="Tips for learning Mandarin from 5 Minute Mandarin's tutors." path="/blog/" nav="blog">
  <h1>Blog</h1>
  <p class="lead">Short tips for learning Mandarin.</p>
  <ul class="tiles tile-grid">
    {
      posts.map((post) => (
        <li>
          <a class="tile" href={href(`/blog/${post.id}/`)}>
            <small>{date(post.data.date)}</small>
            <b>{post.data.title}</b>
            <small>{post.data.summary}</small>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
