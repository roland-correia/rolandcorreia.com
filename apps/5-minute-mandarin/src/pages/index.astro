---
import Base from '../layouts/Base.astro';
import ProgressBar from '../components/ProgressBar.astro';
import { getLessons, unitsOf, pathOf } from '../lib/lessons';
import { href } from '../lib/paths';

// Home: what the tutor and student app does, the way in, then the free practice lessons by unit.
// The button and the "Done" lines are filled in from saved progress by src/scripts/progress-bar.ts.
const lessons = await getLessons();
const sections = unitsOf(lessons);
const first = lessons[0];
---

<Base title="5 Minute Mandarin" path="/">
  <h1>Learn Mandarin<br /><span>with a real tutor.</span></h1>
  <p class="lead">
    Book lessons on Zoom, practise with your class in a group chat, and keep going with five-minute lessons between
    classes.
  </p>
  <div class="group">
    <a class="btn block" href={href('/sign-in/')}>Sign in</a>
    <p class="fine">With Google, Microsoft or Apple. Tutors and students use the same sign-in.</p>
  </div>

  <section class="card" aria-labelledby="how-title">
    <h2 id="how-title">How it works</h2>
    <ul class="ticks">
      <li>Buy credits. One credit books one lesson, in a group or one-to-one.</li>
      <li>See every lesson on your calendar, and join on Zoom with one tap.</li>
      <li>Chat with your class: text, photos and voice notes to practise speaking.</li>
      <li>Your tutor adds the slides from each lesson for you to look back at.</li>
      <li>If your tutor cancels, your credit comes straight back and you get a text.</li>
    </ul>
  </section>

  <section class="group" id="practice" aria-labelledby="practice-title">
    <h2 id="practice-title">Free practice</h2>
    <p class="meta">
      Short lessons for complete beginners. Learn a handful of words, hear them, then check yourself. About five
      minutes each, no sign-in needed.
    </p>
    {first && <a class="btn ghost block" data-start href={href(pathOf(first))}>Start: {first.data.title}</a>}
    <ProgressBar lessons={lessons} />
  </section>

  {
    sections.map((section) => (
      <section class="group" aria-labelledby={`${section.id}-title`}>
        <h3 id={`${section.id}-title`}>{section.name}</h3>
        <p class="meta">{section.blurb}</p>
        <ol class="tiles">
          {section.lessons.map((lesson) => (
            <li>
              <a
                class="tile"
                href={href(pathOf(lesson))}
                data-lesson={lesson.id}
                data-title={lesson.data.title}
              >
                <small>Lesson {lessons.indexOf(lesson) + 1}</small>
                <b>{lesson.data.title}</b>
                <small lang="zh-Hans" class="tile-hanzi">
                  {lesson.data.words.slice(0, 4).map((w) => w.hanzi.replace(/[？…]/g, '')).join(' · ')}
                </small>
                <small class="status" data-status hidden />
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>
